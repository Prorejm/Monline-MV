ameters": ["Expecting us to do all the work!"]}, {"indent": 1, "code": 213, "parameters": [6, 5, false]}, {"indent": 1, "code": 205, "parameters": [6, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 1, "parameters": []}, {"code": 3, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 1, "parameters": []}, {"code": 3, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 505, "parameters": [[]]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Grrr, I do stuff too!"]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["..."]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 3", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Like what exactly?"]}, {"indent": 1, "code": 213, "parameters": [6, 3, false]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 3, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Y'know, be strong. Keep you two safe."]}, {"indent": 1, "code": 401, "parameters": ["Stuff like that."]}, {"indent": 1, "code": 213, "parameters": [-1, 8, false]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["We can handle ourselves."]}, {"indent": 1, "code": 205, "parameters": [5, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 2, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 2, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 205, "parameters": [6, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 13, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 13, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 3", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Grrr...we do everything, you know that."]}, {"indent": 1, "code": 401, "parameters": ["Accept you're only a part of the pride "]}, {"indent": 1, "code": 401, "parameters": ["for one reason."]}, {"indent": 1, "code": 213, "parameters": [6, 1, false]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Hmph, yeah, 'cause you girls can't get "]}, {"indent": 1, "code": 401, "parameters": ["enough of the best stud around!"]}, {"indent": 1, "code": 212, "parameters": [-1, 118, false]}, {"indent": 1, "code": 212, "parameters": [5, 118, false]}, {"indent": 1, "code": 212, "parameters": [6, 118, false]}, {"indent": 1, "code": 231, "parameters": [1, "Lion160", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 5", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["You're the only male around! At least "]}, {"indent": 1, "code": 401, "parameters": ["the only one who can actually give us "]}, {"indent": 1, "code": 401, "parameters": ["cubs..."]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 5", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Exactly, so just shut up and keep to "]}, {"indent": 1, "code": 401, "parameters": ["yourself while we do all the work."]}, {"indent": 1, "code": 401, "parameters": ["We'll get back to you when we actually "]}, {"indent": 1, "code": 401, "parameters": ["need you for something."]}, {"indent": 1, "code": 231, "parameters": [1, "Lion276", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 5", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Hey, fine by me babe. I'll know when "]}, {"indent": 1, "code": 401, "parameters": ["I'm needed, you'll be flicking those "]}, {"indent": 1, "code": 401, "parameters": ["tails in my direction soon enough."]}, {"indent": 1, "code": 101, "parameters"