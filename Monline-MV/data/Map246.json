meters": ["<move character: -3>"]}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 45, "parameters": ["find_path(4,6)"]}, {"code": 18, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 45, "parameters": ["find_path(4,6)"]}, {"code": 18, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 505, "parameters": ["find_path(4,6)"]}, {"indent": 1, "code": 205, "parameters": [5, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 205, "parameters": [6, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 203, "parameters": [6, 0, 4, 6, 6]}, {"indent": 1, "code": 203, "parameters": [5, 0, 6, 7, 6]}, {"indent": 1, "code": 216, "parameters": [1]}, {"indent": 1, "code": 213, "parameters": [6, 2, false]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["By Farinet?"]}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Seems like it. I suppose it makes sense "]}, {"indent": 1, "code": 401, "parameters": ["she'd be mad, we did pretty much succeed "]}, {"indent": 1, "code": 401, "parameters": ["in killing her."]}, {"indent": 1, "code": 213, "parameters": [6, 8, false]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Yeah, if we hadn't I'd still have her "]}, {"indent": 1, "code": 401, "parameters": ["divine spirit inside my body..."]}, {"indent": 1, "code": 213, "parameters": [5, 6, false]}, {"indent": 1, "code": 205, "parameters": [5, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Sorry about that."]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["It's fine, even if it was only for a "]}, {"indent": 1, "code": 401, "parameters": ["few days, being used like that by such "]}, {"indent": 1, "code": 401, "parameters": ["a beautiful, wonderful queen was the "]}, {"indent": 1, "code": 401, "parameters": ["best time of my life."]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I didn't-\\.mmhm...\\.I guess I'm just a "]}, {"indent": 1, "code": 401, "parameters": ["little jealous."]}, {"indent": 1, "code": 213, "parameters": [-1, 2, false]}, {"indent": 1, "code": 355, "parameters": ["map_effects.set_tone(0, 0, 0, 80, 120)"]}, {"indent": 1, "code": 655, "parameters": ["map_effects.set_zoom_blur(110, 120)"]}, {"indent": 1, "code": 655, "parameters": ["map_effects.setup_blur(3, 100, 120)"]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Jealous? Wh-\\.ngh..."]}, {"indent": 1, "code": 213, "parameters": [5, 4, false]}, {"indent": 1, "code": 205, "parameters": [5, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 16, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 16, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["The Pharaoh's divine light, filling "]}, {"indent": 1, "code": 401, "parameters": ["every part of me...how wonderful that "]}, {"indent": 1, "code": 401, "parameters": ["would be. Maybe if she'd chosen me as "]}, {"indent": 1, "code": 401, "parameters": ["her vessel she would still be with us."]}, {"indent": 1, "code": 213, "parameters": [6, 5, false]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Are you questioning the Pharaoh's "]}, {"indent": 1, "code": 401, "parameters": ["decisions?"]}, {"indent": 1, "code": 213, "parameters": [5, 1, false]}, {"indent": 1, "code": 205, "parameters": [5, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Never!"]}, {"indent": 1, "code": 213, "parameters": [-1, 5, false]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Stop arguing! This isn't helping, "]}, {"indent": 1, "code": 401, "parameters": ["something is wrong!\\! We're not...\\.we're "]}, {"indent": 1, "code": 401, "parameters": ["not-\\.\\^"]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Working towards our mission?"]}, {"indent": 1, "code": 213, "parameters": [-1, 1, false]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Exactly! What are we doing sitting about "]}, {"indent": 1, "code": 401, "parameters": ["in this cave? We need to keep searching, "]}, {"indent": 1, "code": 401, "parameters": ["there must be some way to resurrect her!"]}, {"indent": 1, "code": 213, "parameters": [5, 1, false]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["You're right. What have we been doing "]}, {"indent": 1, "code": 401, "parameters": ["wasting our time, what matters is her!"]}, {"indent": 1, "code": 401, "parameters": ["There must be some way to bring her "]}, {"indent": 1, "code": 401, "parameters": ["back, and we're going to find it!"]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 230, "parameters": [120]}, {"indent": 1, "code": 241, "parameters": [{"name": "Exploration - Desert Underground", "volume": 80, "pitch": 100}]}, {"indent": 1, "code": 231, "parameters": [1, "727", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["With the looming threat of Pharaoh Farinet gone, "]}, {"indent": 1, "code": 401, "parameters": ["the desert is relatively safe, aside from the giant "]}, {"indent": 1, "code": 401, "parameters": ["sandwurms of course. But whispers speak of the "]}, {"indent": 1, "code": 401, "parameters": ["travellers who disappear in the night."]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 230, "parameters": [30]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Every so often, someone travelling from the camp "]}, {"indent": 1, "code": 401, "parameters": ["to Djeso just...won't make it.\\. Search parties have "]}, {"indent": 1, "code": 401, "parameters": ["gone out, but no one has ever found the missing."]}, {"indent": 1, "code": 230, "parameters": [30]}, {"indent": 1, "code": 231, "parameters": [1, "Cult1", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Little do the pitiful villagers know, deep beneath "]}, {"indent": 1, "code": 401, "parameters": ["the sands, dark work is being done. Twisted and "]}, {"indent": 1, "code": 401, "parameters": ["cruel magic is cast each and every night, a "]}, {"indent": 1, "code": 401, "parameters": ["sickening experiment. All with a single goal."]}, {"indent": 1, "code": 231, "parameters": [1, "Cult6", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Each step, each victim, a step closer to the "]}, {"indent": 1, "code": 401, "parameters": ["resurrection of the desert's true master. At least"]}, {"indent": 1, "code": 401, "parameters": ["that's what her servants believe."]}, {"indent": 1, "code": 231, "parameters": [1, "Cult8", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Correct or not, there is one truth that remains "]}, {"indent": 1, "code": 401, "parameters": ["in the desert. Don't go wandering in the dark..."]}, {"indent": 1, "code": 101, "parameters": ["", 0, 2, 1]}, {"indent": 1, "code": 401, "parameters": [""]}, {"indent": 1, "code": 401, "parameters": [" \\{\\{   Ending E51 - Desert Omens"]}, {"indent": 1, "code": 121, "parameters": [1121, 1121, 0]}, {"indent": 1, "code": 121, "parameters": [760, 760, 0]}, {"indent": 1, "code": 355, "parameters": ["global_save"]}, {"indent": 1, "code": 353, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 111, "parameters": [4, 1, 3, 105]}, {"indent": 1, "code": 212, "pa