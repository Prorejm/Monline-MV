, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 505, "parameters": ["find_path(6,7)"]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["We didn't forget, right \\n[1]?"]}, {"indent": 1, "code": 213, "parameters": [-1, 6, false]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Well..."]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Look, we'll turn around and head back. "]}, {"indent": 1, "code": 401, "parameters": ["Okay Bastet?"]}, {"indent": 1, "code": 108, "parameters": ["<move character: -3>"]}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 18, "parameters": []}, {"code": 14, "parameters": [0, 0]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 18, "parameters": []}, {"code": 14, "parameters": [0, 0]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 505, "parameters": [[]]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Yeah, come on girl! It's just a stupid "]}, {"indent": 1, "code": 401, "parameters": ["collar, it can't be that important right?"]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 1", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Dominic!"]}, {"indent": 1, "code": 213, "parameters": [7, 6, false]}, {"indent": 1, "code": 101, "parameters": ["Bastet Faceset2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Aw, sorry kitt-kiddies, but rules are "]}, {"indent": 1, "code": 401, "parameters": ["rules. Once I put that curse on you, "]}, {"indent": 1, "code": 401, "parameters": ["that's it, I'm not in control any more."]}, {"indent": 1, "code": 213, "parameters": [7, 3, false]}, {"indent": 1, "code": 101, "parameters": ["Bastet Faceset1", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Maybe you shouldn't have been such "]}, {"indent": 1, "code": 401, "parameters": ["cowards, running away from your quest,"]}, {"indent": 1, "code": 401, "parameters": ["eh? Have a little pride! Hehe!"]}, {"indent": 1, "code": 212, "parameters": [7, 110, false]}, {"indent": 1, "code": 230, "parameters": [4]}, {"indent": 1, "code": 205, "parameters": [7, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 45, "parameters": ["self_switch(\"A\",false)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",false)"]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 205, "parameters": [5, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 205, "parameters": [6, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 203, "parameters": [6, 0, 4, 6, 6]}, {"indent": 1, "code": 203, "parameters": [5, 0, 6, 7, 6]}, {"indent": 1, "code": 203, "parameters": [7, 0, 19, 12, 2]}, {"indent": 1, "code": 216, "parameters": [1]}, {"indent": 1, "code": 213, "parameters": [6, 2, false]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Well now what Kim? \\n[1]?"]}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code