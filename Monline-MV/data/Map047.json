, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "Dancers", "characterIndex": 0, "direction": 4, "pattern": 1}}, {"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": true, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 24, "variableValue": 4, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 205, "parameters": [4, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I'm sorry, you want to do what?"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Enter the lake on \\c[3]Kuos Island\\c[0].\\. "]}, {"indent": 0, "code": 401, "parameters": ["The \"\\c[3]Vessel of the Sea Goddess\\c[0]\"."]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["...that is trespassing on holy "]}, {"indent": 0, "code": 401, "parameters": ["ground...water. I'm afraid I can't "]}, {"indent": 0, "code": 401, "parameters": ["simply let you do such a thing."]}, {"indent": 0, "code": 213, "parameters": [4, 1, false]}, {"indent": 0, "code": 101, "parameters": ["Actor4-1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["But we need to get in there, it's vital "]}, {"indent": 0, "code": 401, "parameters": ["to our mission."]}, {"indent": 0, "code": 213, "parameters": [5, 2, false]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Your mission?"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["We think there may be something there "]}, {"indent": 0, "code": 401, "parameters": ["that will help us get home."]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Hmm, your goal is not selfish, at the "]}, {"indent": 0, "code": 401, "parameters": ["very least. But that doesn't change the "]}, {"indent": 0, "code": 401, "parameters": ["fact that I simply can't help you."]}, {"indent": 0, "code": 101, "parameters": ["Actor4-1", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Lady, we're going to try whether you help "]}, {"indent": 0, "code": 401, "parameters": ["us or not. Do you want to risk us doing "]}, {"indent": 0, "code": 401, "parameters": ["something even worse by stumbling around, "]}, {"indent": 0, "code": 401, "parameters": ["or help us do it safely?"]}, {"indent": 0, "code": 213, "parameters": [5, 8, true]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I will tell you what you need, and no "]}, {"indent": 0, "code": 401, "parameters": ["more. I'd prefer to take as little part "]}, {"indent": 0, "code": 401, "parameters": ["in this as possible. If she found out, "]}, {"indent": 0, "code": 401, "parameters": ["I'd be exiled for sure."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\"She\"? Who, your goddess?"]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[17]The Bishop\\c[0]. If you attempt to enter the "]}, {"indent": 0, "code": 401, "parameters": ["Vessel, she will surely stand in your "]}, {"indent": 0, "code": 401, "parameters": ["way...so if you have any doubts..."]}, {"indent": 0, "code": 101, "parameters": ["Actor4-1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["No, we're doing this. We can't back down, "]}, {"indent": 0, "code": 401, "parameters": ["there's to many people in danger."]}, {"indent": 0, "code": 213, "parameters": [-1, 8, false]}, {"indent": 0, "code": 213, "parameters": [5, 8, true]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["In order for one to enter the Vessel, "]}, {"indent": 0, "code": 401, "parameters": ["human or otherwise, they need to "]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]undertake the ritual\\c[0]. The ritual itself "]}, {"indent": 0, "code": 401, "parameters": ["is not hard, but acquiring the pieces..."]}, {"indent": 0, "code": 101, "parameters": ["Actor4-1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Don't worry, we'll find them. What do "]}, {"indent": 0, "code": 401, "parameters": ["we need?"]}, {"indent": 0, "code": 101, "parameters": ["People2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["A few things; a shard of solid water, "]}, {"indent": 0, "code": 401, "parameters": ["a spiral sea shell, a jar of filtered "]}, {"indent": 0, "code": 401, "parameters": ["sunlight and a sun bleached feather."]}, {"indent": 0, "code": 101, "parameters": ["Actor4-1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["...alright."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Whatever, just write it all down and "]}, {"indent": 0, "code": 401, "parameters": ["how to get it."]}, {"indent": 0, "code": 126, "parameters": [148, 0, 0, 1]}, {"indent": 0, "code": 101, "parameters": ["", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Obtained Sea Ritual Notes!"]}, {"indent": 0, "code": 101, "param