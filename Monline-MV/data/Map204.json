nt": 0, "code": 505, "parameters": [[120]]}, {"indent": 0, "code": 505, "parameters": [[3]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What is this place? Looks like a temple "]}, {"indent": 0, "code": 401, "parameters": ["of some kind. And is that the sky?!"]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1a", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[13]What interests me is why you wouldn't "]}, {"indent": 0, "code": 401, "parameters": ["want to come he-\\.\\^"]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Farinet? Hello?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]I have blocked her connection. She can "]}, {"indent": 0, "code": 401, "parameters": ["no longer see, hear, or feel what goes "]}, {"indent": 0, "code": 401, "parameters": ["on."]}, {"indent": 0, "code": 213, "parameters": [-1, 1, false]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["PXE? No...\\.who are you?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]Please, do not be alarmed. I am not "]}, {"indent": 0, "code": 401, "parameters": ["your enemy."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You're talking with my friend's mouth. "]}, {"indent": 0, "code": 401, "parameters": ["Not a good way to get me to trust you."]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]I have no body of my own, this is all "]}, {"indent": 0, "code": 401, "parameters": ["I can do to talk with you. But if I must "]}, {"indent": 0, "code": 401, "parameters": ["gain your trust then..."]}, {"indent": 0, "code": 205, "parameters": [2, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 42, "parameters": [160]}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 42, "parameters": [160]}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 212, "parameters": [2, 109, false]}, {"indent": 0, "code": 230, "parameters": [5]}, {"indent": 0, "code": 122, "parameters": [86, 86, 0, 0, 13]}, {"indent": 0, "code": 101, "parameters": ["Isis Faceset", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I am Isis. Goddess of Magic and Wisdom, "]}, {"indent": 0, "code": 401, "parameters": ["mother to Horus, and your only hope at "]}, {"indent": 0, "code": 401, "parameters": ["leaving this place as yourself."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Yeah, sorry. But I've met a few Gods and "]}, {"indent": 0, "code": 401, "parameters": ["Godesses along my journey, few of which "]}, {"indent": 0, "code": 401, "parameters": ["I ever want to meet again. Why should I "]}, {"indent": 0, "code": 401, "parameters": ["trust you?"]}, {"indent": 0, "code": 205, "parameters": [2, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 1, "parameters": []}, {"code": 1, "parameters": []}, {"code": 39, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 1, "parameters": []}, {"code": 1, "parameters": []}, {"code": 39, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]Because you are not the only one bound "]}, {"indent": 0, "code": 401, "parameters": ["here. My power was stolen from me, by "]}, {"indent": 0, "code": 401, "parameters": ["the one whose feet you walk in. She used"]}, {"indent": 0, "code": 401, "parameters": ["dark magic and tied us here."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Us?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]My family. Farinet tricked us, trapped "]}, {"indent": 0, "code": 401, "parameters": ["us in this mortal realm, and stole our "]}, {"indent": 0, "code": 401, "parameters": ["power for herself. "]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["And you want what, revenge?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]I want to go home. But while that "]}, {"indent": 0, "code": 401, "parameters": ["witch's magic still stands, I cannot. "]}, {"indent": 0, "code": 401, "parameters": ["The same magic that lets her possess "]}, {"indent": 0, "code": 401, "parameters": ["your body and make it her own."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So we have the same goal. Fine."]}, {"indent": 0, "code": 401, "parameters": ["Do you have a plan?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]Yes. But I'm afraid I cannot explain it "]}, {"indent": 0, "code": 401, "parameters": ["to you. Once you walk away from here, "]}, {"indent": 0, "code": 401, "parameters": ["she'll be able to probe your mind again. "]}, {"indent": 0, "code": 401, "parameters": ["We can't let her know."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Great...\\.I guess I don't have much of "]}, {"indent": 0, "code": 401, "parameters": ["a choice. We need to stop Farinet."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I do have a question I'd like answered.\\."]}, {"indent": 0, "code": 401, "parameters": ["Can you help her? PXE. Surely you have "]}, {"indent": 0, "code": 401, "parameters": ["enough godly powers to do that?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]I...I'm sorry. I'm only able to use her "]}, {"indent": 0, "code": 401, "parameters": ["body like this because of the state of "]}, {"indent": 0, "code": 401, "parameters": ["her mind. She is far to broken for even "]}, {"indent": 0, "code": 401, "parameters": ["me to help."]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]However, she may find some aid among her kind."]}, {"indent": 0, "code": 401, "parameters": ["The pixies of the Mythic Zone are a "]}, {"indent": 0, "code": 401, "parameters": ["dangerous and tricky bunch..."]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]But they care for each other greatly. "]}, {"indent": 0, "code": 401, "parameters": ["And some have magic older than even I. "]}, {"indent": 0, "code": 401, "parameters": ["If anyone can help her, they can."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["...thank you. So what is the first step "]}, {"indent": 0, "code": 401, "parameters": ["towards remvoing Farinet?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]Bring me the Staff of Afeea. If I'm "]}, {"indent": 0, "code": 401, "parameters": ["correct, it will be beside her throne."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Then what?"]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[4]One step at a time Hero. Any more, and "]}, {"indent": 0, "code": 401, "parameters": ["she may figure out my plan before we put it "]}, {"indent": 0, "code": 401, "parameters": ["into action."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Fine, find the staff. Got it."]}, {"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 16, "parameters": []}, {"code": 15, "parameters": [30]}, {"code": 1, "parameters": []}, {"code": 1, "parameters": []}, {"code": 1, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 16, "parameters": []}, {"code": 15, "parameters": [30]}, {"code": 1, "parameters": []}, {"code": 1, "parameters": []}, {"code": 1, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 505, "parameters": [[30]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 230, "parameters": [60]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1a", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[13]-re to the Communion.\\."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Hmm? Oh, just an idea. I thought one "]}, {"indent": 0, "code": 401, "parameters": ["of my friends might be there."]}, {"indent": 0, "code": 101, "parameters": ["Pharaoh Faceset 1a", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[13]I see...well they aren't. But that's "]}, {"indent": 0, "code": 401, "parameters": ["your problem, not mine."]}, {"indent": 0, "code": 201, "parameters": [0, 197, 12, 28, 8, 0]}, {"indent": 0, "cod