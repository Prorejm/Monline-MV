": "Madame Dupalmure", "x": 12, "y": 5, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["people3_02", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Afternoon Sir. Anything catch your eye?"]}, {"indent": 0, "code": 401, "parameters": ["Everything is made personally by me!\\."]}, {"indent": 0, "code": 401, "parameters": ["By hand of course!"]}, {"indent": 0, "code": 111, "parameters": [1, 139, 0, 4, 4]}, {"indent": 1, "code": 111, "parameters": [8, 294]}, {"indent": 2, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Actually we're were given these, we "]}, {"indent": 2, "code": 401, "parameters": ["were told you could give us clothes "]}, {"indent": 2, "code": 401, "parameters": ["for the ball?"]}, {"indent": 2, "code": 101, "parameters": ["people3_02", 1, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Writs of Payment? How many adventurers "]}, {"indent": 2, "code": 401, "parameters": ["is the King inviting to this thing..."]}, {"indent": 2, "code": 401, "parameters": ["I swear, I'm going to end up losing "]}, {"indent": 2, "code": 401, "parameters": ["money because of this..."]}, {"indent": 2, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["What do you mean?"]}, {"indent": 2, "code": 101, "parameters": ["people3_02", 1, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Oh it's nothing, I'm just musing to "]}, {"indent": 2, "code": 401, "parameters": ["myself. I'll get you three measured up."]}, {"indent": 2, "code": 221, "parameters": []}, {"indent": 2, "code": 230, "parameters": [60]}, {"indent": 2, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 2, "code": 401, "parameters": ["Some time later, after the seamstress spends quite "]}, {"indent": 2, "code": 401, "parameters": ["a while taking each of your measurements down "]}, {"indent": 2, "code": 401, "parameters": ["to the tiniest degree."]}, {"indent": 2, "code": 222, "parameters": []}, {"indent": 2, "code": 101, "parameters": ["people3_02", 0, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["I'll have your clothes made up and sent "]}, {"indent": 2, "code": 401, "parameters": ["off to the castle in time for the ball."]}, {"indent": 2, "code": 101, "parameters": ["Kim Face Set 1", 4, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["You can make them that fast? Whenever "]}, {"indent": 2, "code": 401, "parameters": ["I had to get clothes fitted they'd take "]}, {"indent": 2, "code": 401, "parameters": ["weeks..."]}, {"indent": 2, "code": 101, "parameters": ["people3_02", 1, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["I'm an expert in my field dear. Every "]}, {"indent": 2, "code": 401, "parameters": ["single piece of fabric in this shop is "]}, {"indent": 2, "code": 401, "parameters": ["made from scratch by me. Such a simple "]}, {"indent": 2, "code": 401, "parameters": ["task would never take that long."]}, {"indent": 2, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["You're going to be making our clothes "]}, {"indent": 2, "code": 401, "parameters": ["right now? Wow, you must be magic."]}, {"indent": 2, "code": 213, "parameters": [1, 1, false]}, {"indent": 2, "code": 101, "parameters": ["people3_02", 1, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["I would advise you not to throw around "]}, {"indent": 2, "code": 401, "parameters": ["baseless accusations like that if you "]}, {"indent": 2, "code": 401, "parameters": ["know whats good for you!"]}, {"indent": 2, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Uh, alright?"]}, {"indent": 2, "code": 101, "parameters": ["people3_02", 1, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Now if that will be all, please leave. "]}, {"indent": 2, "code": 401, "parameters": ["I have a lot of work to do."]}, {"indent": 2, "code": 126, "parameters": [294, 1, 0, 1]}, {"indent": 2, "code": 122, "parameters": [139, 139, 0, 0, 4]}, {"indent": 2, "code": 122, "parameters": [37, 37, 0, 0, 131]}, {"indent": 2, "code": 115, "parameters": []}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 412, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 302, "parameters": [2, 1, 1, 800, true]}, {"indent": 0, "code": 605, "parameters": [2, 11, 1, 800]}, {"indent": 0, "code": 605, "parameters": [2, 90, 1, 800]}, {"indent": 0, "code": 605, "parameters": [2, 7, 1, 1400]}, {"indent": 0, "code": 605, "parameters": [2, 167, 1, 3750]}, {"indent": 0, "code": 605, "parameters": [2, 192, 1, 2100]}, {"indent": 0, "code": 111, "parameters": [2, "A", 1]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Wow these prices are..."]}, {"indent": 1, "code": 101, "parameters": ["people3_02", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Well, the people here are capable of "]}, {"indent": 1, "code": 401, "parameters": ["paying. Perhaps you should head "]}, {"indent": 1, "code": 401, "parameters": ["downtown if you can't afford the prices "]}, {"indent": 1, "code": 401, "parameters": ["here."]}, {"indent": 1, "code": 123, "parameters": ["A", 0]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": false, "through": false, "trigger": 