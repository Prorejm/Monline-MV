tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}]}, {"id": 4, "name": "Goblin", "x": 9, "y": 7, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 213, "parameters": [0, 1, false]}, {"indent": 0, "code": 205, "parameters": [0, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 16, "parameters": []}, {"code": 14, "parameters": [0, 0]}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 16, "parameters": []}, {"code": 14, "parameters": [0, 0]}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 101, "parameters": ["Goblin Girl Faceset", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Human! I won't let you take me!"]}, {"indent": 0, "code": 205, "parameters": [0, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 1, "parameters": []}, {"code": 2, "parameters": []}, {"code": 16, "parameters": []}, {"code": 14, "parameters": [0, 0]}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 1, "parameters": []}, {"code": 2, "parameters": []}, {"code": 16, "parameters": []}, {"code": 14, "parameters": [0, 0]}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 301, "parameters": [0, 57, false, true]}, {"indent": 0, "code": 601, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Goblin Girl Faceset", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Don't kill me!"]}, {"indent": 1, "code": 101, "parameters": ["Player TF Knight Faceset  3", 3, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I'm not going to kill you. Come on, "]}, {"indent": 1, "code": 401, "parameters": ["let's get you to the village center."]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 603, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Goblin Girl Faceset", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I knew my hubby was lying when he said "]}, {"indent": 1, "code": 401, "parameters": ["you humans were all tough, you ain't all "]}, {"indent": 1, "code": 401, "parameters": ["that tough! Y'all just stuck-up losers!\\. "]}, {"indent": 1, "code": 401, "parameters": ["But I know how to loosen you up..."]}, {"indent": 1, "code": 101, "parameters": ["Goblin Girl Faceset", 7, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Howza bout somma my funtime juice?\\. I keep it for "]}, {"indent": 1, "code": 401, "parameters": ["when my hubby has been away too long, but I don't "]}, {"indent": 1, "code": 401, "parameters": ["mind sharing a little. Come on, drink up."]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["The liquid sloshing down your throat burns as it "]}, {"indent": 1, "code": 401, "parameters": ["hits your skin and your breaths grow long and heavy, "]}, {"indent": 1, "code": 401, "parameters": ["dizziness overtaking you and blackness creeping up "]}, {"indent": 1, "code": 401, "parameters": ["the edges of your vision."]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 230, "parameters": [120]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["It's the middle of the day and you're on all fours, "]}, {"indent": 1, "code": 401, "parameters": ["readying yourself for the next three.\\. \\c[8]Next three?\\c[0]"]}, {"indent": 1, "code": 401, "parameters": ["Surrounding you are three...somethings, someones."]}, {"indent": 1, "code": 401, "parameters": ["You can't make out faces, or features."]}, {"indent": 1, "code": 231, "parameters": [1, "Knight180", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["\\c[8]Why are you on all fours? \\c[0]Half naked, with only "]}, {"indent": 1, "code": 401, "parameters": ["some of your armor? \\c[8]One holds something, a lead."]}, {"indent": 1, "code": 401, "parameters": ["\\c[0]It connects to your collar. \\c[8]Why a collar? \\c[0]Because "]}, {"indent": 1, "code": 401, "parameters": ["you are supposed to have a collar."]}, {"indent": 1, "code": 231, "parameters": [1, "Knight181", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["They still pump away inside you, you'd forgotten "]}, {"indent": 1, "code": 401, "parameters": ["about that. \\c[8]Why had you forgotten? \\c[0]You love this, "]}, {"indent": 1, "code": 401, "parameters": ["don't you? Yes. \\c[8]But why? \\c[0]Because you are supposed "]}, {"indent": 1, "code": 401, "parameters": ["to. \\c[8]You are a knight aren't you? \\c[0]Aren't you? "]}, {"indent": 1, "code": 231, "parameters": [1, "Knight182", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["\\c[8]A knight follows orders, \\c[0]of those in more power. "]}, {"indent": 1, "code": 401, "parameters": ["They have power, \\c[8]over you. \\c[0]That is why you serve."]}, {"indent": 1, "code": 401, "parameters": ["Serve them. \\c[8]Follow them. \\c[0]Adore them. Yes. You love "]}, {"indent": 1, "code": 401, "parameters": ["this, being used by your superiors. "]}, {"indent": 1, "code": 231, "parameters": [1, "Knight183", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["The sun is setting, you have been here a long time."]}, {"indent": 1, "code": 401, "parameters": ["\\c[8]Have you? \\c[0]It feels like a second, stretched into "]}, {"indent": 1, "code": 401, "parameters": ["eternity. \\c[8]Why does that matter? \\c[0]It doesn't."]}, {"indent": 1, "code": 231, "parameters": [1, "Knight184", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Hello?\\. \\c[8]Who is there? \\c[0]\\n[15] can you hear me?"]}, {"indent": 1, "code": 401, "parameters": ["\\c[8]Of course you can. But who can you hear? \\c[0]They are "]}, {"indent": 1, "code": 401, "parameters": ["close, good. You have done good. Serving. Bowing "]}, {"indent": 1, "code": 401, "parameters": ["down. \\n[15] snap out of it. \\c[8]Why?"]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 231, "parameters": [1, "Knight244", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["You snap out of your daze, finding yourself still "]}, {"indent": 1, "code": 401, "parameters": ["in the goblin hut. You're lying on the floor, "]}, {"indent": 1, "code": 401, "parameters": ["\\c[8]drooling, \\c[0]Captain Tristan kneels before you."]}, {"indent": 1, "code": 101, "parameters": ["Angry Blonde Guy Face", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I was worried we'd lost you. Good to see "]}, {"indent": 1, "code": 401, "parameters": ["you're still with us."]}, {"indent": 1, "code": 101, "parameters": ["Player TF Knight Faceset  1", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Where? When? How long was I-?"]}, {"indent": 1, "code": 101, "parameters": ["Angry Blonde Guy Face", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Still in the goblin village. Nighttime. "]}, {"indent": 1, "code": 401, "parameters": ["Only a few minutes.\\. I've escorted the "]}, {"indent": 1, "code": 401, "parameters": ["goblin that knocked you out to the "]}, {"indent": 1, "code": 401, "parameters": ["center."]}, {"indent": 1, "code": 101, "parameters": ["Angry Blonde Guy Face", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["We've still got a job to do, clean "]}, {"indent": 1, "code": 401, "parameters": ["yourself up and get back in there."]}, {"indent": 1, "code": 101, "parameters": ["Player TF Knight Faceset  1", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Y-yes Sir."]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["The Captain exits, leaving you alone in the small "]}, {"indent": 1, "code": 401, "parameters": ["hut. That was...something. You can barely remember, "]}, {"indent": 1, "code": 401, "parameters": ["like you just woke up from a dream...but you don't "]}, {"indent": 1, "code": 401, "parameters": ["think the feelings will leave you, not for a while."]}, {"indent": 1, "code": 231, "parameters": [1, "Knight522", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["You find a scrap of cloth on the ground and clean "]}, {"indent": 1, "code": 401, "parameters": ["up the drool from both of your lips...that was some "]}, {"indent": 1, "code": 401, "parameters": ["dream..."]}, {"indent": 1, "code": 122, "parameters": [125, 125, 1, 0, 10]}, {"indent": 1, "code": 122, "parameters": [147, 147, 1, 0, 1]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 235, "parameters": [1]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 604, "parameters": []}, {"indent": 0, "code": 123, "parameters": ["A", 0]}, {"indent": 0, "code": 122, "parameters": [134, 134, 1, 0, 1]}, {"indent": 0, "code": 355, "parameters": ["setSelfSwitch(338, 19, \"A\", true)"]}, {"indent": 0, "code