rameters": ["I-I can't move! My body! It's turning "]}, {"indent": 0, "code": 401, "parameters": ["to stone!"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset6", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Pedestals can't move \\n[1]!"]}, {"indent": 0, "code": 401, "parameters": ["They can't talk either!"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 6, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["My mouth won't open!"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset6", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\{Yes!\\. Yes!\\. Oh god I needed this!"]}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 4, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["Can't think straight, need to stop "]}, {"indent": 0, "code": 401, "parameters": ["Kim...\\.Gotta move...\\.Tired.\\."]}, {"indent": 0, "code": 401, "parameters": ["So tired."]}, {"indent": 0, "code": 231, "parameters": [1, "Gargoyle78", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["In the end you become nothing more than a stone "]}, {"indent": 0, "code": 401, "parameters": ["pillar, a perch for the new gargoyle to sit upon.\\."]}, {"indent": 0, "code": 401, "parameters": ["Perhaps one day a place to build a nest around."]}, {"indent": 0, "code": 231, "parameters": [1, "Gargoyle34", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["Of course one part of you retains its shape and "]}, {"indent": 0, "code": 401, "parameters": ["although you're not much more than a stone dildo"]}, {"indent": 0, "code": 401, "parameters": ["anymore you still have the briefest glimmer of "]}, {"indent": 0, "code": 401, "parameters": ["thought. Not that you'd have much to say..."]}, {"indent": 0, "code": 231, "parameters": [1, "Gargoyle29", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["When Kim isn't perched upon you, she's usually off "]}, {"indent": 0, "code": 401, "parameters": ["searching for a mate to help build her nest. Though "]}, {"indent": 0, "code": 401, "parameters": ["she doesn't seem to have much luck keeping them "]}, {"indent": 0, "code": 401, "parameters": ["around, she's always got you to sit-\\.fall back on."]}, {"indent": 0, "code": 101, "parameters": ["", 0, 2, 1]}, {"indent": 0, "code": 401, "parameters": [""]}, {"indent": 0, "code": 401, "parameters": ["\\{ Ending D11 - A Rock and a Hard Place"]}, {"indent": 0, "code": 121, "parameters": [955, 955, 0]}, {"indent": 0, "code": 355, "parameters": ["global_save"]}, {"indent": 0, "code": 353, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 0, "stepAnime": false, "through": false, "trigger": 3, "walkAnime": true, "image": {"tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}]}, {"id": 7, "name": "Sewer Wreckage", "x": 11, "y": 11, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": true, "list": [{"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": true, "through": false, "trigger": 0, "walkAnime": false, "image": {"tileId": 0, "characterName": "!$sewagewaste", "characterI