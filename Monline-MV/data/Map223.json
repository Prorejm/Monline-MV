ple to 'help'."]}, {"indent": 2, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 2, "code": 401, "parameters": ["It's a good life. Quiet, fun and peaceful "]}, {"indent": 2, "code": 401, "parameters": ["all the same. Round the clock room service "]}, {"indent": 2, "code": 401, "parameters": ["is pretty great too."]}, {"indent": 2, "code": 101, "parameters": ["", 0, 2, 1]}, {"indent": 2, "code": 401, "parameters": [""]}, {"indent": 2, "code": 401, "parameters": ["\\{\\{ Ending E29 - Hot and Unbothered"]}, {"indent": 2, "code": 121, "parameters": [1011, 1011, 0]}, {"indent": 2, "code": 355, "parameters": ["global_save"]}, {"indent": 2, "code": 353, "parameters": []}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 412, "parameters": []}, {"indent": 1, "code": 122, "parameters": [105, 105, 1, 0, 1]}, {"indent": 1, "code": 121, "parameters": [747, 747, 0]}, {"indent": 1, "code": 355, "parameters": ["global_save"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Take a Dip"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": true, "through": false, "trigger": 0, "walkAnime": false, "image": {"tileId": 0, "characterName": "!Flame", "characterIndex": 6, "direction": 2, "pattern": 1}}]}, {"id": 10, "name": "Broken Sign", "x": 13, "y": 7, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": true, "list": [{"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters