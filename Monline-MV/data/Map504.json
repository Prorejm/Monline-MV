dent": 1, "code": 401, "parameters": ["Oh, its you three. Changed your mind "]}, {"indent": 1, "code": 401, "parameters": ["about the reading?\\$"]}, {"indent": 1, "code": 119, "parameters": ["Choice"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Ah, welcome \\n[1], Kim, Dominic..."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["How do you know our names?"]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I foresaw your arrival..."]}, {"indent": 0, "code": 213, "parameters": [-1, 8, true]}, {"indent": 0, "code": 230, "parameters": [60]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I'm kidding, you're not exactly nobodies "]}, {"indent": 0, "code": 401, "parameters": ["around here. Most people have at least "]}, {"indent": 0, "code": 401, "parameters": ["heard of you."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["But what you've done is in the past, "]}, {"indent": 0, "code": 401, "parameters": ["if you're here it means you want to "]}, {"indent": 0, "code": 401, "parameters": ["know the future, yes?"]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 6", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I've seen a lot of weird things in this "]}, {"indent": 0, "code": 401, "parameters": ["game, but I don't believe anyone can "]}, {"indent": 0, "code": 401, "parameters": ["predict the future, even here."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So sure of yourself! But know that "]}, {"indent": 0, "code": 401, "parameters": ["every action has a reaction, the future "]}, {"indent": 0, "code": 401, "parameters": ["is merely cause and effect. "]}, {"indent": 0, "code": 401, "parameters": ["The past shapes the future!"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I guess thats true."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So, want a reading? Come on, it's only "]}, {"indent": 0, "code": 401, "parameters": ["1000G!"]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["That's a rip-off."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So is everything in this bazaar. \\."]}, {"indent": 0, "code": 401, "parameters": ["Besides, I can only do one reading "]}, {"indent": 0, "code": 401, "parameters": ["per person, so I have to over charge."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Now do you want one or not? Because "]}, {"indent": 0, "code": 401, "parameters": ["there are plenty more people to grift-\\.uh, "]}, {"indent": 0, "code": 401, "parameters": ["customers to serve.\\$"]}, {"indent": 0, "code": 118, "parameters": ["Choice"]}, {"indent": 0, "code": 355, "parameters": ["disable_choice(1, \"$game_party.gold < 1000\")"]}, {"indent": 0, "code": 102, "parameters": [["Sure (1000G)", "No Thanks"], 2]}, {"indent": 0, "code": 402, "parameters": [0, ["Sure (1000G)", "No Thanks"]]}, {"indent": 1, "code": 250, "parameters": [{"name": "Coin", "pitch": 100, "volume": 80}]}, {"indent": 1, "code": 125, "parameters": [1, 0, 1000]}, {"indent": 1, "code": 123, "parameters": ["B", 0]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Sure (1000G)"]}, {"indent": 1, "code": 111, "parameters": [2, "A", 1]}, {"indent": 2, "code": 101, "parameters": ["Priestess Faceset 1", 2, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Of course, all as I predicted."]}, {"indent": 2, "code": 213, "parameters": [1, 5, false]}, {"indent": 2, "code": 101, "parameters": ["Priestess Faceset 1", 2, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Now if you're not buying then you "]}, {"indent": 2, "code": 401, "parameters": ["can get lost. I'm trying to make a "]}, {"indent": 2, "code": 401, "parameters": ["living here."]}, {"indent": 2, "code": 123, "parameters": ["A", 0]}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 411, "parameters": []}, {"indent": 2, "code": 213, "parameters": [1, 5, false]}, {"indent": 2, "code": 101, "parameters": ["Priestess Faceset 1", 2, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Then why did you even come in?\\."]}, {"indent": 2, "code": 401, "parameters": ["Wasting my damn time..."]}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 412, "parameters": []}, {"indent": 1, "code": 201, "parameters": [0, 503, 38, 13, 2, 0]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 0, "stepAnime": false, "through": false, "trigger": 3, "walkAnime": true, "image": {"tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}, {"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": true, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "B", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Just as I foretold..."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The future is a dangerous thing, once "]}, {"indent": 0, "code": 401, "parameters": ["seen, it cannot be unseen. When the "]}, {"indent": 0, "code": 401, "parameters": ["reading is complete, you must leave "]}, {"indent": 0, "code": 401, "parameters": ["this room and never return."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What? Why?"]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Mostly because it ruins the illusion, "]}, {"indent": 0, "code": 401, "parameters": ["seeing a different future. And I don't "]}, {"indent": 0, "code": 401, "parameters": ["do refunds for people who dislike "]}, {"indent": 0, "code": 401, "parameters": ["what I say."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 2", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Also things tend to...\\}n-nevermind."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Anyway, who wants the reading then?"]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 6", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["No thanks."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uh..."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Why did you pay if you didn't want to "]}, {"indent": 0, "code": 401, "parameters": ["try? Sounds kinda fun."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Go on then, you do it."]}, {"indent": 0, "code": 205, "parameters": [4, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 4, "parameters": []}, {"code": 2, "parameters": []}, {"code": 19, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 4, "parameters": []}, {"code": 2, "parameters": []}, {"code": 19, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 3, "parameters": []}, {"code": 19, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 3, "parameters": []}, {"code": 19, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["How does this work exactly?"]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["We shuffle a deck cards and the card"]}, {"indent": 0, "code": 401, "parameters": ["you deal will tell your future."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Alright, hit me!"]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["This is fortune telling, not poker. "]}, {"indent": 0, "code": 401, "parameters": ["These are tarot cards.\\. Now, lets begin."]}, {"indent": 0, "code": 230, "parameters": [30]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Welcome, young traveler, to the realm "]}, {"indent": 0, "code": 401, "parameters": ["of destiny. I sense you seek the "]}, {"indent": 0, "code": 401, "parameters": ["guidance of the cards."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Yeah, um, I guess I'm looking for some "]}, {"indent": 0, "code": 401, "parameters": ["guidance or whatever."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Excellent. Sit down, and let the "]}, {"indent": 0, "code": 401, "parameters": ["mystical dance of the cards reveal "]}, {"indent": 0, "code": 401, "parameters": ["your fate. Now, concentrate as you "]}, {"indent": 0, "code": 401, "parameters": ["shuffle the deck."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So, like, do I just... shuffle them like "]}, {"indent": 0, "code": 401, "parameters": ["this?"]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Ah, the cards respond to your touch. "]}, {"indent": 0, "code": 401, "parameters": ["A true maestro of fate, you are. "]}, {"indent": 0, "code": 401, "parameters": ["Now, when you feel ready, lay out a"]}, {"indent": 0, "code": 401, "parameters": ["card before us."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["A masterpiece of card placement! "]}, {"indent": 0, "code": 401, "parameters": ["Your destiny unfolds. Let us interpret "]}, {"indent": 0, "code": 401, "parameters": ["the mysterious messages within the cards."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uh, what do they say?"]}, {"indent": 0, "code": 250, "parameters": [{"name": "Page Turn", "pitch": 100, "volume": 80}]}, {"indent": 0, "code": 231, "parameters": [1, "TarotD15", 1, 0, 272, 208, 40, 40, 0, 0]}, {"indent": 0, "code": 233, "parameters": [1, 90]}, {"indent": 0, "code": 230, "parameters": [4]}, {"indent": 0, "code": 233, "parameters": [1, 0]}, {"indent": 0, "code": 232, "parameters": [1, null, 1, 0, 272, 208, 40, 40, 255, 0, 1, true]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The first card, the reversed Devil.\\. "]}, {"indent": 0, "code": 401, "parameters": ["A shadowy past emerges, a moment "]}, {"indent": 0, "code": 401, "parameters": ["of temptation and betrayal. "]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["It seems you once strayed from the path, "]}, {"indent": 0, "code": 401, "parameters": ["lured by selfish desires."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Yeah..."]}, {"indent": 0, "code": 250, "parameters": [{"name": "Page Turn", "pitch": 100, "volume": 80}]}, {"indent": 0, "code": 235, "parameters": [1]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Acknowledgment is the first step toward "]}, {"indent": 0, "code": 401, "parameters": ["redemption. Let us see what the next card "]}, {"indent": 0, "code": 401, "parameters": ["reveals. "]}, {"indent": 0, "code": 250, "parameters": [{"name": "Page Turn", "pitch": 100, "volume": 80}]}, {"indent": 0, "code": 231, "parameters": [1, "TarotD09", 1, 0, 272, 208, 40, 40, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The Hermit.\\. A solitary figure seeking "]}, {"indent": 0, "code": 401, "parameters": ["inner truth. It's a call to "]}, {"indent": 0, "code": 401, "parameters": ["self-examination and the journey "]}, {"indent": 0, "code": 401, "parameters": ["toward healing."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Self-examination, got it. So, like, "]}, {"indent": 0, "code": 401, "parameters": ["I should, um, think about my actions "]}, {"indent": 0, "code": 401, "parameters": ["and stuff?"]}, {"indent": 0, "code": 250, "parameters": [{"name": "Page Turn", "pitch": 100, "volume": 80}]}, {"indent": 0, "code": 235, "parameters": [1]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Indeed. Confront your past decisions "]}, {"indent": 0, "code": 401, "parameters": ["with honesty and humility. "]}, {"indent": 0, "code": 401, "parameters": ["Now, onto the final card. "]}, {"indent": 0, "code": 250, "parameters": [{"name": "Page Turn", "pitch": 100, "volume": 80}]}, {"indent": 0, "code": 231, "parameters": [1, "TarotD07", 1, 0, 272, 208, 40, 40, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The Chariot.\\. A triumphant symbol of "]}, {"indent": 0, "code": 401, "parameters": ["growth and progress. It signifies "]}, {"indent": 0, "code": 401, "parameters": ["victory after overcoming trials."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Victory? So I can make up for what I did?"]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The Chariot indicates that your efforts "]}, {"indent": 0, "code": 401, "parameters": ["to make amends will be rewarded. "]}, {"indent": 0, "code": 401, "parameters": ["The road to redemption is paved with "]}, {"indent": 0, "code": 401, "parameters": ["humility and sincere actions."]}, {"indent": 0, "code": 250, "parameters": [{"name": "Page Turn", "pitch": 100, "volume": 80}]}, {"indent": 0, "code": 235, "parameters": [1]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The future has been revealed.\\."]}, {"indent": 0, "code": 401, "parameters": ["I hope you found the reading useful."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Yeah, I think I did."]}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Then I bid you farewell and the best "]}, {"indent": 0, "code": 401, "parameters": ["of luck in the future."]}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Priestess Faceset 1", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Now don't come back."]}, {"indent": 0, "code": 201, "parameters": [0, 503, 38, 13, 2, 0]}, {"indent": 0, "code": 216, "parameters": [0]}, {"indent": 0, "code": 123, "parameters": ["C", 0]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well that was weird."]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Mhmm..."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well she was right about a few things..."]}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 0, "stepAnime": false, "through": false, "trigger": 3, "walkAnime": true, "image": {"tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}, {"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "C", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["Priestess Faceset 2", 2, 0, 2]}, {"indent": 0, "cod