 1}, "directionFix": false, "list": [{"indent": 0, "code": 108, "parameters": ["<page trigger: Region_enter 1>"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Come forth, mortal."]}, {"indent": 0, "code": 213, "parameters": [-1, 1, false]}, {"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 45, "parameters": ["find_path(8,7)"]}, {"code": 19, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 45, "parameters": ["find_path(8,7)"]}, {"code": 19, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": ["find_path(8,7)"]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Woah, who are you?"]}, {"indent": 0, "code": 231, "parameters": [1, "Anubis842", 0, 0, 0, 0, 100, 100, 0, 0]}, {"indent": 0, "code": 232, "parameters": [1, null, 0, 0, 0, 0, 100, 100, 255, 0, 180, false]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\{I am Anubis."]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Great, another one?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Watch your words carefully mortal."]}, {"indent": 0, "code": 401, "parameters": ["I am the true Anubis. What you have "]}, {"indent": 0, "code": 401, "parameters": ["met before are merely my followers."]}, {"indent": 0, "code": 401, "parameters": ["I am the original."]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So you're a god? Like Isis?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So you've met mother? Interesting..."]}, {"indent": 0, "code": 401, "parameters": ["But that matters not to me now."]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What do you want?"]}, {"indent": 0, "code": 232, "parameters": [1, null, 0, 0, 0, 0, 100, 100, 0, 0, 240, false]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Did I not tell you to watch your tongue, "]}, {"indent": 0, "code": 401, "parameters": ["lest I pluck it from your mouth? "]}, {"indent": 0, "code": 401, "parameters": ["Is this how mortals act to one who "]}, {"indent": 0, "code": 401, "parameters": ["saved their life?"]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You saved me?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You were sent to Ammit for all eternity"]}, {"indent": 0, "code": 401, "parameters": ["by my former followers. The ones who "]}, {"indent": 0, "code": 401, "parameters": ["worship a false goddess now.\\. "]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I decided to take you from Ammit's grasp "]}, {"indent": 0, "code": 401, "parameters": ["and brought you here."]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Um, thanks.\\. I guess I should get back to "]}, {"indent": 0, "code": 401, "parameters": ["the world of the living then."]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Excuse me?"]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well, I've got things to do down there. "]}, {"indent": 0, "code": 401, "parameters": ["Like helping your, uh, mother."]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The matters of mortals are none of my "]}, {"indent": 0, "code": 401, "parameters": ["concern. I saved you from a horrid fate "]}, {"indent": 0, "code": 401, "parameters": ["and you attempt to flee without repaying "]}, {"indent": 0, "code": 401, "parameters": ["me? How far has humanity fallen..."]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I guess I can repay you. What do you "]}, {"indent": 0, "code": 401, "parameters": ["need?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You guess? What I need? I don't need "]}, {"indent": 0, "code": 401, "parameters": ["anything. I am a god. You will be "]}, {"indent": 0, "code": 401, "parameters": ["serving me for the rest of time, consider "]}, {"indent": 0, "code": 401, "parameters": ["it a honor mortal."]}, {"indent": 0, "code": 101, "parameters": ["Player Ghost Face", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Do I have to?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Yes.\\. This conversation bores me."]}, {"indent": 0, "code": 401, "parameters": ["But your pitifulness amuses me somewhat."]}, {"indent": 0, "code": 401, "parameters": ["I shall let you chose the form you will "]}, {"indent": 0, "code": 401, "parameters": ["serve me in."]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Become as me, ascended past your "]}, {"indent": 0, "code": 401, "parameters": ["humanity. Or cling to it, desperate to "]}, {"indent": 0, "code": 401, "parameters": ["relaim what you can have nevermore."]}, {"indent": 0, "code": 118, "parameters": ["Choose"]}, {"indent": 0, "code": 102, "parameters": [["Anubis", "Humanity", "Can't I just go back?"], 3]}, {"indent": 0, "code": 402, "parameters": [0, ["Anubis", "Humanity", "Can't I just go back?"]]}, {"indent": 1, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Good."]}, {"indent": 1, "code": 212, "parameters": [-1, 116, false]}, {"indent": 1, "code": 230, "parameters": [5]}, {"indent": 1, "code": 322, "parameters": [1, "Player TF Pharaoh", 0, "Original Player Face", 0]}, {"indent": 1, "code": 230, "parameters": [60]}, {"indent": 1, "code": 213, "parameters": [-1, 1, false]}, {"indent": 1, "code": 101, "parameters": ["MGFaceset20", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["No questions.\\. Now come, serve your god."]}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 4, "parameters": []}, {"code": 4, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 4, "parameters": []}, {"code": 4, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 505, "parameters": [[]]}, {"indent": 1, "code": 231, "parameters": [1, "Anubis843", 0, 0, 0, 0, 100, 100, 0, 0]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["You can't resist the urge to obey, but why would "]}, {"indent": 1, "code": 401, "parameters": ["you?\\. "]}, {"indent": 1, "code": 232, "parameters": [1, null, 0, 0, 0, 0, 100, 100, 255, 0, 240, false]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["He's a god.\\. Your god now.\\. You're confused at his "]}, {"indent": 1, "code": 401, "parameters": ["changing of your form, but who are you to question "]}, {"indent": 1, "code": 401, "parameters": ["a god?\\. All you can seem to think about his how you "]}, {"indent": 1, "code": 401, "parameters": ["can use this new body to honor him."]}, {"indent": 1, "code": 250, "parameters": [{"name": "Whoosh 1", 