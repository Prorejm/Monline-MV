 "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh good, you've finally woken up. Had a "]}, {"indent": 0, "code": 401, "parameters": ["nice sleep?"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What's going on?\\. Why am I tied up?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The mistress checked you over while you"]}, {"indent": 0, "code": 401, "parameters": ["were sleeping, apparently you're too"]}, {"indent": 0, "code": 401, "parameters": ["'tainted' for breeding."]}, {"indent": 0, "code": 111, "parameters": [4, 8, 0]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Where's Mark?"]}, {"indent": 1, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Your friend? White haired guy?\\. I left "]}, {"indent": 1, "code": 401, "parameters": ["him behind when I carried you here. When "]}, {"indent": 1, "code": 401, "parameters": ["I came back he was gone.\\. Didn't want to "]}, {"indent": 1, "code": 401, "parameters": ["waste his time saving your sorry ass."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 111, "parameters": [4, 18, 0]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Where's Alaru?"]}, {"indent": 1, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Your friend? Blonde girl?\\. I left her "]}, {"indent": 1, "code": 401, "parameters": ["behind when I carried you here. When I "]}, {"indent": 1, "code": 401, "parameters": ["came back she was gone.\\. Didn't want to "]}, {"indent": 1, "code": 401, "parameters": ["waste her time saving your sorry ass."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["It's a shame you're actually kind of "]}, {"indent": 0, "code": 401, "parameters": ["cute. But I can't go against the "]}, {"indent": 0, "code": 401, "parameters": ["mistress's orders, so you're "]}, {"indent": 0, "code": 401, "parameters": ["gonna get thrown in the vat."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uhh, what's 'the vat'?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["The big pool in front of you dumbass.\\."]}, {"indent": 0, "code": 401, "parameters": ["It's a delicious mix of honey and"]}, {"indent": 0, "code": 401, "parameters": ["hornet's poison. \\.We couldn't let you "]}, {"indent": 0, "code": 401, "parameters": ["go to waste after all."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What do you mean to waste?\\. What's gonna"]}, {"indent": 0, "code": 401, "parameters": ["happen to me if I go in that pool?"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset7", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh, you'll see soon enough.\\..\\.."]}, {"indent": 0, "code": 401, "parameters": [""]}, {"indent": 0, "code": 401, "parameters": ["Now hurry up, I've got bees to kill."]}, {"indent": 0, "code": 212, "parameters": [-1, 19, false]}, {"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 14, "parameters": [3, 0]}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 14, "parameters": [3, 0]}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 212, "parameters": [-1, 50, true]},