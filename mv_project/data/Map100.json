T'S "]}, {"indent": 0, "code": 401, "parameters": ["PRACTICALLY MY JOB TO BE ANGRY AT YOU!\\."]}, {"indent": 0, "code": 401, "parameters": ["YOU WATCH HAPPILY AS PEOPLE ARE HAVING "]}, {"indent": 0, "code": 401, "parameters": ["THEIR EXISTENCE ERASED!"]}, {"indent": 0, "code": 213, "parameters": [8, 5, false]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["YOU'RE PLEASED WHEN PEOPLE ARE TURNED "]}, {"indent": 0, "code": 401, "parameters": ["INTO MORE PLAYTHINGS FOR YOU! YOU'RE "]}, {"indent": 0, "code": 401, "parameters": ["NOTHING BUT A CHILD WITH NO SELF "]}, {"indent": 0, "code": 401, "parameters": ["RESTRAINT!"]}, {"indent": 0, "code": 213, "parameters": [11, 3, false]}, {"indent": 0, "code": 101, "parameters": ["Evil", 3, 1, 1]}, {"indent": 0, "code": 401, "parameters": ["\\fn[Doctor Glitch]\\fz[14]And that's enough from you."]}, {"indent": 0, "code": 212, "parameters": [8, 96, false]}, {"indent": 0, "code": 230, "parameters": [90]}, {"indent": 0, "code": 213, "parameters": [-1, 8, true]}, {"indent": 0, "code": 213, "parameters": [-1, 2, false]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["PXE?!"]}, {"indent": 0, "code": 205, "parameters": [8, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 17, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 213, "parameters": [8, 8, true]}, {"indent": 0, "code": 101, "parameters": ["PXE Faceset", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Hello there \\fn[Doctor Glitch]\\fz[14]\\n[1]!\\fr "]}, {"indent": 0, "code": 401, "parameters": ["Welcome to the beautiful island of "]}, {"indent": 0, "code": 401, "parameters": ["Xanadu!\\. I am your PXE or Personal "]}, {"indent": 0, "code": 401, "parameters": ["Xanadu Expert!"]}, {"