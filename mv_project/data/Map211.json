": ["Christmas Faces2", 0, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Unfortunately there's a heavy snowstorm "]}, {"indent": 2, "code": 401, "parameters": ["blowing in so you don't have long before "]}, {"indent": 2, "code": 401, "parameters": ["it becomes impossible to find anything."]}, {"indent": 2, "code": 401, "parameters": ["So keep moving! And good luck!"]}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 404, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Yes"]}, {"indent": 1, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["That's fine, take your time. I need to "]}, {"indent": 1, "code": 401, "parameters": ["fix up Blitzen and clear up this mess "]}, {"indent": 1, "code": 401, "parameters": ["before I can get going anyway."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "Christmas Sprites1", "characterIndex": 4, "direction": 4, "pattern": 1}}]}, {"id": 5, "name": "EV005", "x": 11, "y": 11, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 201, "parameters": [0, 108, 10, 11, 8, 0]}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3,