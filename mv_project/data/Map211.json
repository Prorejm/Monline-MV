e, "switch2Valid": false, "variableValid": true, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 93, "variableValue": 1, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uh...hello?"]}, {"indent": 0, "code": 101, "parameters": ["", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Aho-ho-hauck! *cough* *cough*"]}, {"indent": 0, "code": 101, "parameters": ["", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh my. I appear to have crashed mid-flight."]}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 201, "parameters": [0, 211, 19, 8, 8, 0]}, {"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 4, "parameters": []}, {"code": 18, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 4, "parameters": []}, {"code": 18, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": [[]]}, {"indent": 0, "code": 205, "parameters": [4, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 45, "parameters": ["self_switch(\"A\",true)"]}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 6, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["Santa Claus?!"]}, {"indent": 0, "code": 401, "parameters": ["I mean I feel that was probably obvious "]}, {"indent": 0, "code": 401, "parameters": ["due to all the snow and presents and "]}, {"indent": 0, "code": 401, "parameters": ["reindeer pulled sleigh but still...Santa! "]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Hello there young man, \\n[1] wasn't it?"]}, {"indent": 0, "code": 401, "parameters": ["And Kim too, good to meet you both."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You know our names?"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["It's Santa Claus! He knows everyone's "]}, {"indent": 0, "code": 401, "parameters": ["name!"]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Indeed my boy. Though it appears in my "]}, {"indent": 0, "code": 401, "parameters": ["crash I've lost some of my cargo. I'll "]}, {"indent": 0, "code": 401, "parameters": ["need to find them if I keep my job, "]}, {"indent": 0, "code": 401, "parameters": ["wouldn't want to get fired."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Wait, what? Fired? I though you said you "]}, {"indent": 0, "code": 401, "parameters": ["were Santa Claus?"]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well, yes. I am. One of them at least."]}, {"indent": 0, "code": 401, "parameters": ["How else do you think we can deliver "]}, {"indent": 0, "code": 401, "parameters": ["presents to everyone in the world in one "]}, {"indent": 0, "code": 401, "parameters": ["night?"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh. Okay I guess, that makes sense. "]}, {"indent": 0, "code": 401, "parameters": ["Though I always just figured you were "]}, {"indent": 0, "code": 401, "parameters": ["magic."]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["No no. That's ridiculous. We're just "]}, {"indent": 0, "code": 401, "parameters": ["simple old men who fly around on "]}, {"indent": 0, "code": 401, "parameters": ["sleds pulled by mechanical flying "]}, {"indent": 0, "code": 401, "parameters": ["reindeer."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Right...anyway, I'm kind of confused. "]}, {"indent": 0, "code": 401, "parameters": ["Last time I checked it was june. "]}, {"indent": 0, "code": 401, "parameters": ["Why are you here?"]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["My boy, it's always Christmas somewhere!"]}, {"indent": 0, "code": 401, "parameters": ["Timezones and all that."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["That's not how timezones work. "]}, {"indent": 0, "code": 401, "parameters": ["Like, at all."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Ignoring all that, you said something "]}, {"indent": 0, "code": 401, "parameters": ["about missing cargo? Anything we "]}, {"indent": 0, "code": 401, "parameters": ["can do to help?"]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["So kind of you to offer, and yes. I "]}, {"indent": 0, "code": 401, "parameters": ["appear to have dropped some of "]}, {"indent": 0, "code": 401, "parameters": ["the presents I was carrying in my crash."]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["No doubt they are around here somewhere. "]}, {"indent": 0, "code": 401, "parameters": ["But I don't have time to go searching for "]}, {"indent": 0, "code": 401, "parameters": ["them, I need to stay here and repair "]}, {"indent": 0, "code": 401, "parameters": ["Blitzen."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well we'd be happy to help look for them."]}, {"indent": 0, "code": 401, "parameters": ["Right Kim?"]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Sure."]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Thank you both of you. They can't be too "]}, {"indent": 0, "code": 401, "parameters": ["far. This side of the river at least. "]}, {"indent": 0, "code": 401, "parameters": ["Other than that I can't help you. Perhaps "]}, {"indent": 0, "code": 401, "parameters": ["that tracking idea wasn't so crazy..."]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["When you're ready I'll send you over to "]}, {"indent": 0, "code": 401, "parameters": ["wherever they might turn up."]}, {"indent": 0, "code": 401, "parameters": ["Be careful though, I doubt you'll be"]}, {"indent": 0, "code": 401, "parameters": ["the only ones out there tonight."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 4", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What do you mean?"]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well a couple of years back some of the "]}, {"indent": 0, "code": 401, "parameters": ["elves got laid off due to lack of budget "]}, {"indent": 0, "code": 401, "parameters": ["and they kind of made it their mission to "]}, {"indent": 0, "code": 401, "parameters": ["destroy Christmas ever since."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["How did you run out of money to pay them?"]}, {"indent": 0, "code": 401, "parameters": ["Aren't you supposed to be magic and "]}, {"indent": 0, "code": 401, "parameters": ["stuff?"]}, {"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Like I said, no magic. Just body doubles "]}, {"indent": 0, "code": 401, "parameters": ["and a lot of poorly paid labour. Anyway,"]}, {"indent": 0, "code": 401, "parameters": ["be wary out there. They'll know some "]}, {"indent": 0, "code": 401, "parameters": ["presents got dropped, I'm sure of it."]}, {"indent": 0, "code": 122, "parameters": [93, 93, 0, 0, 2]}, {"indent": 0, "code": 121, "parameters": [725, 725, 0]}, {"indent": 0, "code": 355, "parameters": ["global_save"]}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": true, "through": false, "trigger": 0, "walkAnime": false, "image": {"tileId": 0, "characterName": "!Flame", "characterIndex": 7, "direction": 2, "pattern": 1}}, {"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": true, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 93, "variableValue": 2, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 0, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}]}, {"id": 3, "name": "EV003", "x": 17, "y": 6, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": true, "list": [{"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["Is that fire coming out of this reindeer?"]}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": true, "through": false, "trigger": 0, "walkAnime": false, "image": {"tileId": 0, "characterName": "!Flame", "characterIndex": 3, "direction": 4, "pattern": 1}}]}, {"id": 4, "name": "Santa", "x": 20, "y": 7, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": true, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 93, "variableValue": 1, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Hello \\n[1]! Ready to begin hunting down "]}, {"indent": 0, "code": 401, "parameters": ["those presents?"]}, {"indent": 0, "code": 102, "parameters": [["Yes", "No"], 2]}, {"indent": 0, "code": 402, "parameters": [0, ["Yes", "No"]]}, {"indent": 1, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Want me to explain how this works?"]}, {"indent": 1, "code": 102, "parameters": [["I know how to Play", "Yes"], 0]}, {"indent": 1, "code": 402, "parameters": [0, ["I know how to Play", "Yes"]]}, {"indent": 2, "code": 101, "parameters": ["Christmas Faces2", 0, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Off you trot then."]}, {"indent": 2, "code": 221, "parameters": []}, {"indent": 2, "code": 355, "parameters": ["weather(4, 1, \"Snow_01\")"]}, {"indent": 2, "code": 245, "parameters": [{"name": "Wind", "volume": 10, 