rameters": ["extra conditions"]}, {"indent": 0, "code": 408, "parameters": ["variable 132 = 2"]}, {"indent": 0, "code": 231, "parameters": [1, "Miko2865", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Mhm..."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uh."]}, {"indent": 0, "code": 231, "parameters": [1, "Miko1858", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh, um. H-hey, what's up?"]}, {"indent": 0, "code": 235, "parameters": [1]}, {"indent": 0, "code": 355, "parameters": ["combine_choices"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(1, \"$game_switches[227] == false\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(2, \"$game_switches[228] == false\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(3, \"$game_switches[229] == false\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(4, \"$game_variables[140] != 2\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(5, \"!$game_party.items.include?($data_items[270])\")"]}, {"indent": 0, "code": 102, "parameters": [["Does \"Fox\" mean anything to you?", "Does \"Flower\" mean anything to you?", "Does \"Water\" mean anything to you?", "Are you Inari's Sister?"], 0]}, {"indent": 0, "code": 402, "parameters": [0, ["Does \"Fox\" mean anything to you?", "Does \"Flower\" mean anything to you?", "Does \"Water\" mean anything to you?", "Are you Inari's Sister?"]]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Uh...nope. Sorry. Uh...gomen'nasai."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Does \"Fox\" mean anything to you?"]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Sorry, we don't really get many flowers"]}, {"indent": 1, "code": 401, "parameters": ["around here.\\. Oh, I think Suzume likes "]}, {"indent": 1, "code": 401, "parameters": ["to grow flowers! Maybe she knows?"]}, {"indent": 1, "code": 111, "parameters": [1, 141, 0, 0, 0]}, {"indent": 2, "code": 122, "parameters": [141, 141, 0, 0, 1]}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 412, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [2, "Does \"Flower\" mean anything to you?"]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Duh, the onsen. But if it's not "]}, {"indent": 1, "code": 401, "parameters": ["that...then I don't know!"]}, {"indent": 1, "code": 111, "parameters": [1, 142, 0, 0, 0]}, {"indent": 2, "code": 122, "parameters": [142, 142, 0, 0, 1]}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 412, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [3, "Does \"Water\" mean anything to you?"]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Me? I wish...apparently I wasn't a "]}, {"indent": 1, "code": 401, "parameters": ["\"suitable candidate\" for the ceremony."]}, {"indent": 1, "code": 401, "parameters": ["Not that it worked on those two "]}, {"indent": 1, "code": 401, "parameters": ["either..."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 102, "parameters": [["Show her Suzume's List", "Talk to me.", "Nevermind"], 0]}, {"indent": 0, "code": 402, "parameters": [0, ["Show her Suzume's List", "Talk to me.", "Nevermind"]]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Gin-wha? Bellawho? I don't know what these "]}, {"indent": 1, "code": 401, "parameters": ["are...gomen'nasai. \\. Oh, wait! This one!"]}, {"indent": 1, "code": 401, "parameters": ["Goat's Weed! I've used this before "]}, {"indent": 1, "code": 401, "parameters": ["when...uh. "]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Try looking in the east hall. Upstairs."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Show her Suzume's List"]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I'm so happy I came here. Screw reality, "]}, {"indent": 1, "code": 401, "parameters": ["this place is heaven. I was so scared "]}, {"indent": 1, "code": 401, "parameters": ["when we arrived, everyone was panicking "]}, {"indent": 1, "code": 401, "parameters": ["and there was so much screaming..."]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 3, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I ran away from the city, trying to get "]}, {"indent": 1, "code": 401, "parameters": ["away from it all...but the forest was "]}, {"indent": 1, "code": 401, "parameters": ["worse. Everything was out to get me, and "]}, {"indent": 1, "code": 401, "parameters": ["it nearly did...but she saved me...us."]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["And here, I'm safe. Warm, fed, happy. "]}, {"indent": 1, "code": 401, "parameters": ["Surrounded by kind, beautiful shrine "]}, {"indent": 1, "code": 401, "parameters": ["maidens. "]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Each a wonder in their own right, some "]}, {"indent": 1, "code": 401, "parameters": ["mature and commanding, some demure and "]}, {"indent": 1, "code": 401, "parameters": ["gentle. "]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Draped in pure white kimonos that hide "]}, {"indent": 1, "code": 401, "parameters": ["and hint toward curves so soft, bodies "]}, {"indent": 1, "code": 401, "parameters": ["so warm I could..."]}, {"indent": 1, "code": 101, "parameters": ["Shrine Maiden Faceset 9", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Uh, um...what were we talking about?"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [2, "Talk to me."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 5, "moveType": 0, "priorityType": 1, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "Miko Sprite Set 3", "characterIndex": 0, "direction": 4, "pattern": 1}}]}]}