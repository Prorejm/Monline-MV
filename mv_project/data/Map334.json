r a few."]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Got it! Carrots for Petra!"]}, {"indent": 0, "code": 101, "parameters": ["", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Obtained Carrots for Petra!"]}, {"indent": 0, "code": 126, "parameters": [144, 0, 0, 1]}, {"indent": 0, "code": 123, "parameters": ["A", 0]}, {"indent": 0, "code": 101, "parameters": ["people4_04", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh, bring the basket back when you're "]}, {"indent": 0, "code": 401, "parameters": ["done I guess."]}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 1, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "People4", "characterIndex": 7, "direction": 8, "pattern": 1}}, {"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": true, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["people4_04", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uh...can I help you with something?"]}, {"indent": 0, "code": 102, "parameters": [["Yes", "No"], 2]}, {"indent": 0, "code": 402, "parameters": [0, ["Yes", "No"]]}, {"indent": 1, "code": 104, "parameters": [18]}, {"indent": 1, "code": 111, "parameters": [1, 18, 0, 144, 0]}, {"indent": 2, "code": 101, "parameters": ["people4_04", 5, 0, 2]}, {"indent": 2, "code": 401, "parameters": ["Yeah...thats the basket of carrots I "]}, {"indent": 2, "code": 401, "parameters": ["asked you to give to Petra. Why, is "]}, {"indent": 2, "code": 401, "parameters": ["there somet