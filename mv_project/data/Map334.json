 {"id": 7, "name": "Gareth BT", "x": 8, "y": 6, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 101, "parameters": ["people4_04", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Ah!"]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh, you were the guard at the gate."]}, {"indent": 0, "code": 101, "parameters": ["people4_04", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Squire Garath ma'am!"]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh come on, no need to be like that. "]}, {"indent": 0, "code": 401, "parameters": ["We're the same rank. Call me \\n[15]."]}, {"indent": 0, "code": 101, "parameters": ["people4_04", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["R-Right, miss \\n[15]."]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Good enough..."]}, {"indent": 0, "code": 101, "parameters": ["people4_04", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["S-so what can I help you with?"]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well I'm supposed to be helping wherever "]}, {"indent": 0, "code": 401, "parameters": ["I can right now. Anything I can help you "]}, {"indent": 0, "code": 401, "parameters": ["with Garath?"]}, {"indent": 0, "code": 101, "parameters": ["people4_04", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Uh...well I'm just preparing the "]}, {"indent": 0, "code": 401, "parameters": ["food right now..."]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Then I'll help with that!"]}, {"indent": 0, "code": 101, "parameters": ["people4_04", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["S-sure. You can peel the potatoes "]}, {"indent": 0, "code": 401, "parameters": ["I guess?"]}, {"indent": 0, "code": 101, "parameters": ["Player TF Knight Faceset  1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Understood!"]}, {"indent": 0, "code": 111, "parameters": [6, -1, 8]}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 2, "parameters": []}, {"code": 4, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 2, "parameters": []}, {"code": 4, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 505, "parameters": [[]]}, {"indent": 1, "code": 205, "parameters": [7, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 19, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 19, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 411, "parameters": []}, {"indent": 1, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 19, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 19, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 205, "parameters": [7, {"repeat": false, "skippable": false, "wait": false, "list": [{"code": 19, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 19, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["You scooch up next to the young soldier and pick up "]}, {"indent": 0, "code": 401, "parameters": ["a bag of potatoes.\\. You can't lie, you definitely "]}, {"indent": 0, "code": 401, "parameters": ["wouldn't be able to pick this up in your old body. "]}, {"indent": 0, "code": 401, "parameters": ["Either one.\\. Being this strong is...nice."]}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 0, "code": 401, "parameters": ["You can't help notice Squire Garath's glances in "]}, {"indent": 0, "code": 401, "parameters": ["your direction, his eyes keep flickering back to "]}, {"indent": 0, "code": 401, "parameters": ["your hands as you deftly peel each potato in one "]}, {"indent": 0, "code": 401, "parameters": ["swift motion."]}, {"indent": 0, "code": 102, "parameters": [["Call Him Out", "Just Peel the Potatoes"], 0]}, {"indent": 0, "code": 402, "parameters": [0, ["Call Him Out", "Just Peel the Potatoes"]]}, {"indent": 1, "code": 122, "parameters": [145, 145, 1, 0, 1]}, {"indent": 1, "code": 101, "parameters": ["Player TF Knight Faceset  1", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Careful, you'll end up cutting your "]}, {"indent": 1, "code": 401, "parameters": ["fingers off if you're not watching what "]}, {"indent": 1, "code": 401, "parameters": ["you're doing."]}, {"indent": 1, "code": 101, "parameters": ["people4_04", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Huh? Oh! Right, thanks..."]}, {"indent": 1, "code": 101, "parameters": ["", 0, 1, 2]}, {"indent": 1, "code": 401, "parameters": ["Suprisingly it doesn't take long for the bag to "]}, {"indent": 1, "code": 401, "parameters": ["empty, a pile of freshly peeled potatoes sitting "]}, {"indent": 1, "code": 401, "parameters": ["by your side."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Call Him Out"]},