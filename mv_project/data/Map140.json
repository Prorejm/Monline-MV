 "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": true, "list": [{"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 4, "moveType": 0, "priorityType": 1, "stepAnime": true, "through": false, "trigger": 0, "walkAnime": false, "image": {"tileId": 0, "characterName": "$Horse Cart", "characterIndex": 0, "direction": 4, "pattern": 1}}]}, {"id": 2, "name": "Auto", "x": 0, "y": 0, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 39, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 39, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 355, "parameters": ["cam_follow(1)"]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["That breeze feels so good, especially "]}, {"indent": 0, "code": 401, "parameters": ["after the desert."]}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh, you folks have travelled through "]}, {"indent": 0, "code": 401, "parameters": ["the desert?"]}, {"indent": 0, "code": 111, "parameters": [0, 247, 0]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Uh...yeah. I woke up there a while "]}, {"indent": 1, "code": 401, "parameters": ["back but...\\.well I'm happy to be out "]}, {"indent": 1, "code": 401, "parameters": ["of there."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 411, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I woke up there and let me tell you, this "]}, {"indent": 1, "code": 401, "parameters": ["is a nice change of scenery from miles "]}, {"indent": 1, "code": 401, "parameters": ["upon miles of sand."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["And you two? How long have you been on "]}, {"indent": 0, "code": 401, "parameters": ["the road for?"]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 1", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Not that much longer for me, I woke up "]}, {"indent": 0, "code": 401, "parameters": ["in an awful, zombie infested city.\\. Unlike"]}, {"indent": 0, "code": 401, "parameters": ["Dominic, I was actually quite happy to "]}, {"indent": 0, "code": 401, "parameters": ["see the sun.\\. Maybe I'm just used to it."]}, {"indent": 0, "code": 111, "parameters": [0, 247, 1]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 3, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Oh, assuming much aren't you? I get out "]}, {"indent": 1, "code": 401, "parameters": ["plenty, sure it's mostly at night, but "]}, {"indent": 1, "code": 401, "parameters": ["it's not called nightlife for nothing!"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["What about you young miss? You look a "]}, {"indent": 0, "code": 401, "parameters": ["little fresh faced to be travelling in "]}, {"indent": 0, "code": 401, "parameters": ["such dangerous times."]}, {"indent": 0, "code": 101, "parameters": ["Player TF Princess Faceset 1", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Believe me, I've had enough walking for "]}, {"indent": 0, "code": 401, "parameters": ["a lifetime.\\. Soon I'll have done a lap of "]}, {"indent": 0, "code": 401, "parameters": ["the island. "]}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You came the long way around from the "]}, {"indent": 0, "code": 401, "parameters": ["forest? Colour me impressed. That's a "]}, {"indent": 0, "code": 401, "parameters": ["long journey."]}, {"indent": 0, "code": 101, "parameters": ["Player TF Princess Faceset 1", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["One I don't plan on making ever again."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 3", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["You mentioned these being 'dangerous "]}, {"indent": 0, "code": 401, "parameters": ["times', any chance we could know what "]}, {"indent": 0, "code": 401, "parameters": ["we're supposed to be guarding you from?"]}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Well there's a war on! Sure the front "]}, {"indent": 0, "code": 401, "parameters": ["line is way ahead of us, but those elves "]}, {"indent": 0, "code": 401, "parameters": ["are sneaky. Smart enough to cut off the "]}, {"indent": 0, "code": 401, "parameters": ["soldiers supply lines by attacking carts!"]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 3", 3, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["We encounted a few elves by the city, so "]}, {"indent": 0, "code": 401, "parameters": ["its unsurprising there along the roads "]}, {"indent": 0, "code": 401, "parameters": ["too."]}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Eyep, I hear they've had to pull soldiers "]}, {"indent": 0, "code": 401, "parameters": ["away from the front to guard the city. "]}, {"indent": 0, "code": 401, "parameters": ["In case of assassination or kidnapping."]}, {"indent": 0, "code": 111, "parameters": [0, 247, 0]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["So, um...how far is this camp?"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 411, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Hey, how far is this camp?"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["People3", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Oh, not that far. Couple of hours maybe? "]}, {"indent": 0, "code": 101, "parameters": ["Dominic Faceset 2", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Great."]}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 230, "parameters": [120]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 2", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["How are you holding up \\n[1]?"]}, {"indent": 0, "code": 101, "parameters": ["Player TF Princess Faceset 1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I'm fine. It's a little weird being like "]}, {"indent": 0, "code": 401, "parameters": ["this, but I'm getting used to it. "]}, {"indent": 0, "code": 401, "parameters": ["I appreciate the concern though."]}, {"indent": 0, "code": 111, "parameters": [0, 247, 0]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["So have you had a look over "]}, {"indent": 1, "code": 401, "parameters": ["your body yet?"]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 6", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Yeah, he has. Haven't you '\\n[15]'?"]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I...didn't mean it like that."]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 6", 1, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Right."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 411, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["So, checked yourself out yet? Not gonna "]}, {"indent": 1, "code": 401, "parameters": ["lie, that's the first thing I'd do."]}, {"indent": 1, "code": 101, "parameters": ["Kim Face Set 6", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["..."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 412, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["Player TF Princess Faceset 2", 7, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I-I've been a little busy. Y'know, trying "]}, {"indent": 0, "code": 401, "parameters": ["not to lose my mind. But thanks for your "]}, {"indent": 0, "code": 401, "parameters": ["input."]}, {"indent": 0, "code": 111, "parameters": [0, 247, 0]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Right..."]}, {"indent": 1, "code": 101, "parameters": ["Player TF Princess Faceset 2", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Hmph, maybe next time one of you will "]}, {"indent": 1, "code": 401, "parameters": ["be the transformed one, then I can-\\|\\^"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 411, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 3, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Always happy to assist a fair maiden."]}, {"indent": 1, "code": 101, "parameters": ["Player TF Princess Faceset 2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Watch it, or you'll find out how fair "]}, {"in