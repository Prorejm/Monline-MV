 "code": 111, "parameters": [1, 141, 0, 0, 0]}, {"indent": 2, "code": 122, "parameters": [141, 141, 0, 0, 1]}, {"indent": 2, "code": 0, "parameters": []}, {"indent": 1, "code": 412, "parameters": []}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [2, "Does \"Flower\" mean anything to you?"]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Nothing that would interest you my dear."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [3, "Does \"Water\" mean anything to you?"]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Inari told you about her lovely black "]}, {"indent": 1, "code": 401, "parameters": ["hair, and you assumed it was me? How "]}, {"indent": 1, "code": 401, "parameters": ["sweet. But no, you're looking at the "]}, {"indent": 1, "code": 401, "parameters": ["wrong woman. I'm much more fun."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 102, "parameters": [["Use the Fox Fire", "Show her Suzume's List", "Talk to me", "Nevermind"], 0]}, {"indent": 0, "code": 402, "parameters": [0, ["Use the Fox Fire", "Show her Suzume's List", "Talk to me", "Nevermind"]]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["A gift, for me? Arigato Onii-chan."]}, {"indent": 1, "code": 212, "parameters": [0, 143, false]}, {"indent": 1, "code": 230, "parameters": [5]}, {"indent": 1, "code": 205, "parameters": [0, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 41, "parameters": ["Miko Inari Set", 4]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 41, "parameters": ["Miko Inari Set", 4]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 230, "parameters": [5]}, {"indent": 1, "code": 213, "parameters": [0, 1, true]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 231, "parameters": [1, "Foxy 258", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 4", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Well this is a surprise...one of Inari's "]}, {"indent": 1, "code": 401, "parameters": ["\"jokes\" for her dear Onee-san?\\. She's a "]}, {"indent": 1, "code": 401, "parameters": ["fun one truly. Still, as enjoyable as this "]}, {"indent": 1, "code": 401, "parameters": ["little change is..."]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 4", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Must it come with such an inner fire?"]}, {"indent": 1, "code": 401, "parameters": ["I suppose Youko really does need it. "]}, {"indent": 1, "code": 401, "parameters": ["I might not, but that doesn't mean I "]}, {"indent": 1, "code": 401, "parameters": ["won't take advantage of it..."]}, {"indent": 1, "code": 231, "parameters": [1, "Foxy 260", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 4", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Now then boys...who wants to take "]}, {"indent": 1, "code": 401, "parameters": ["one for the team? Who dares to try "]}, {"indent": 1, "code": 401, "parameters": ["and tame the beast?"]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I give my body for the cause."]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Dominic."]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 6, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Don't worry \\n[1], I got this."]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["..."]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 4", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Oh, the boy thinks himself a man..."]}, {"indent": 1, "code": 401, "parameters": ["Come then Onii-chan..."]}, {"indent": 1, "code": 221, "parameters": []}, {"indent": 1, "code": 235, "parameters": [1]}, {"indent": 1, "code": 230, "parameters": [120]}, {"indent": 1, "code": 117, "parameters": [42]}, {"indent": 1, "code": 230, "parameters": [60]}, {"indent": 1, "code": 222, "parameters": []}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 7, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["..."]}, {"indent": 1, "code": 101, "parameters": ["Other Player End Faces 4", 5, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["You held out very well, I'm impressed. "]}, {"indent": 1, "code": 401, "parameters": ["But I guess I'm just a little "]}, {"indent": 1, "code": 401, "parameters": ["more...practiced then you were "]}, {"indent": 1, "code": 401, "parameters": ["expecting. Daijobu..."]}, {"indent": 1, "code": 212, "parameters": [0, 143, false]}, {"indent": 1, "code": 230, "parameters": [5]}, {"indent": 1, "code": 205, "parameters": [0, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 41, "parameters": ["Miko Sprite Set 1", 3]}, {"code": 0, "parameters": []}]}]}, {"indent": 1, "code": 505, "parameters": [[{"code": 41, "parameters": ["Miko Sprite Set 1", 3]}, {"code": 0, "parameters": []}]]}, {"indent": 1, "code": 230, "parameters": [5]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Sugoi, perhaps I shall ask Inari to whip "]}, {"indent": 1, "code": 401, "parameters": ["me up some more...it'll provide a nice "]}, {"indent": 1, "code": 401, "parameters": ["change. Still, good to be back..."]}, {"indent": 1, "code": 401, "parameters": ["Ja ne boys."]}, {"indent": 1, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Dominic?"]}, {"indent": 1, "code": 101, "parameters": ["Dominic Faceset 2", 4, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["...please don't mention this to Kim."]}, {"indent": 1, "code": 122, "parameters": [140, 140, 0, 0, 3]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [1, "Use the Fox Fire"]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["Ah, daijobu. I'm sure I can be of "]}, {"indent": 1, "code": 401, "parameters": ["assistance.\\. I'm certain I saw some "]}, {"indent": 1, "code": 401, "parameters": ["ginseng in the kitchens. It has quite "]}, {"indent": 1, "code": 401, "parameters": ["the flavour, you know?"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [2, "Show her Suzume's List"]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I must say, as much as I love my hair, "]}, {"indent": 1, "code": 401, "parameters": ["I do sometimes wonder what it would be "]}, {"indent": 1, "code": 401, "parameters": ["like shorter. More like Rina's. "]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 0, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["She says she only keeps it short because "]}, {"indent": 1, "code": 401, "parameters": ["long hair gets in the way when she's "]}, {"indent": 1, "code": 401, "parameters": ["eating, but I don't believe her. She "]}, {"indent": 1, "code": 401, "parameters": ["certainly does enjoy eating though."]}, {"indent": 1, "code": 101, "parameters": ["SchoolAFemale2", 2, 0, 2]}, {"indent": 1, "code": 401, "parameters": ["I don't know how she keeps her figure,"]}, {"indent": 1, "code": 401, "parameters": ["just hang around the north-west part "]}, {"indent": 1, "code": 401, "parameters": ["of the shrine and she'll show up, trying "]}, {"indent": 1, "code": 401, "parameters": ["to pinch some food from the kitchen."]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 402, "parameters": [3, "Talk to me"]}, {"indent": 1, "code": 0, "parameters": []}, {"indent": 0, "code": 404, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 5, "moveType": 0, "priorityType": 1, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "Miko Sprite Set 1", "characterIndex": 3, "direction": 2, "pattern": 1}}]}, {"id": 3, "name": "Inari 2", "x": 3, "y": 11, "pages": [{"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": false, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "A", "itemId": 1, "actorId": 1}, "directionFix": false, "list": [{"indent": 0, "code": 108, "parameters": ["extra conditions"]}, {"indent": 0, "code": 408, "parameters": ["variable 132 = 2"]}, {"indent": 0, "code": 231, "parameters": [1, "Miko1926", 0, 0, 0, 0, 100, 100, 255, 0]}, {"indent": 0, "code": 101, "parameters": ["ScifiFemale1", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Hai hai! You need something Onii-san?"]}, {"indent": 0, "code": 235, "parameters": [1]}, {"indent": 0, "code": 355, "parameters": ["combine_choices"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(1, \"$game_switches[227] == false\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(2, \"$game_switches[228] == false\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(3, \"$game_switches[229] == false\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(4, \"$game_variables[140] != 2\")"]}, {"indent": 0, "code": 655, "parameters": ["hide_choice(5, \"!$game_party.items.include?($data_items[270])\")"]}, {"i