e": 401, "parameters": ["obviously, otherwise I would have known!"]}, {"indent": 0, "code": 401, "parameters": ["I went through all of my other slaves "]}, {"indent": 0, "code": 401, "parameters": ["waiting for you to come back!"]}, {"indent": 0, "code": 101, "parameters": ["Succubus Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Some of the newbies had quite the shock, "]}, {"indent": 0, "code": 401, "parameters": ["they've only been girls for a few hours!\\. "]}, {"indent": 0, "code": 401, "parameters": ["It's no wonder they passed out so "]}, {"indent": 0, "code": 401, "parameters": ["quickly!"]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset3", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I...er...\\c[27]am so sorry Mistress!\\. I will "]}, {"indent": 0, "code": 401, "parameters": ["take whatever punishment you give to me "]}, {"indent": 0, "code": 401, "parameters": ["with a smile on my face!"]}, {"indent": 0, "code": 101, "parameters": ["Succubus Face", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["*Sigh* Fine, whatever.\\. I'm bored,"]}, {"indent": 0, "code": 401, "parameters": ["feel yourself up for a bit or something, I"]}, {"indent": 0, "code": 401, "parameters": ["don't care."]}, {"indent": 0, "code": 101, "parameters": ["MGFaceset3", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["\\c[27]Yes mistress,\\. if that is what you wish!"]}, {"indent": 0, "code": 221, "parameters": []}, {"indent": 0, "code": 223, "parameters": [[-255, -255, -255, 0], 20, true]}, {"indent": 0, "code": 231, "parameters": [1, "Dark Angel1", 0, 0, 75, 0, 45, 45, 255, 0]}, {"indent": 0, "code": 222, "parameters": []}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 1]}, {"indent": 0, "code": 401, "parameters": ["And so that's what do you.\\. For the rest of eternity"]}, {"indent": 0, "code": 401, "parameters": ["you follow your mistress' every instruction to the"]}, {"indent": 0, "code": 401, "parameters": ["letter. Never failing once to please her you soon "]}, {"indent": 0, "code": 401, "parameters": ["outrank the rest of her slaves."]}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 1]}, {"indent": 0, "code": 401, "parameters": ["Eventually the mistress does decide to punish you"]}, {"indent": 0, "code": 401, "parameters": ["for your 'disappearance' but you couldn't care less."]}, {"indent": 0, "code": 101, "parameters": ["", 0, 1, 1]}, {"indent": 0, "code": 401, "parameters": ["Of course if you had however known that despite"]}, {"indent": 0, "code": 401, "parameters": ["her appearance the mistress is not as female as "]}, {"indent": 0, "code": 401, "parameters": ["she seems you might have thought differently, but"]}, {"indent": 0, "code": 401, "parameters": ["alas,\\. it's far to late to do anything now..."]}, {"indent": 0, "code": 101, "parameters": ["", 0, 2, 1]}, {"indent": 0, "code": 401, "parameters": [""]}, {"indent": 0, "code": 401, "parameters": ["\\{    Ending C17 - Hell is Other People"]}, {"indent": 0, "code": 121, "parameters": [929, 929, 0]}, {"indent": 0, "code": 355, "parameters": ["global_save"]}, {"indent": 0, "code": 353, "parameters": []}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 0, "stepAnime": false, "through": false, "trigger": 3, "walkAnime": true, "image": {"tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}]}]}