ers": ["Wait, that's basically like every "]}, {"indent": 0, "code": 401, "parameters": ["monster in this game."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["At least it makes sense for zombies..."]}, {"indent": 0, "code": 401, "parameters": ["Come on, let's get you up."]}, {"indent": 0, "code": 205, "parameters": [-1, {"repeat": false, "skippable": false, "wait": true, "list": [{"code": 41, "parameters": ["Original Player Sprite", 0]}, {"code": 16, "parameters": []}, {"code": 0, "parameters": []}]}]}, {"indent": 0, "code": 505, "parameters": [[{"code": 41, "parameters": ["Original Player Sprite", 0]}, {"code": 16, "parameters": []}, {"code": 0, "parameters": []}]]}, {"indent": 0, "code": 505, "parameters": ["Original Player Sprite"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Thanks...\\.so is this really it? I'm done "]}, {"indent": 0, "code": 401, "parameters": ["for just like that..."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["It usually takes a little while to turn, "]}, {"indent": 0, "code": 401, "parameters": ["it varies depending on the individual's "]}, {"indent": 0, "code": 401, "parameters": ["BMI, or what would be their BMI in this "]}, {"indent": 0, "code": 401, "parameters": ["game. Still, since there's no cure..."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["It doesn't really matter how long..."]}, {"indent": 0, "code": 401, "parameters": ["Great. Sounds like I'd better get "]}, {"indent": 0, "code": 401, "parameters": ["moving then."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 1, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Moving?\\. What are you talking about?"]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 4, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I'm not just going to sit here and \"die\"."]}, {"indent": 0, "code": 401, "parameters": ["Do you have any clues about where "]}, {"indent": 0, "code": 401, "parameters": ["those zombies were coming from? If I "]}, {"indent": 0, "code": 401, "parameters": ["find the source, maybe there's a cure."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 6, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["If I knew, I'd already be on my way...\\."]}, {"indent": 0, "code": 401, "parameters": ["I suppose you could ask around, maybe "]}, {"indent": 0, "code": 401, "parameters": ["someone else has an idea."]}, {"indent": 0, "code": 101, "parameters": ["Original Player Face", 0, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["Good idea. Thanks uhh...\\.Kim, right?"]}, {"indent": 0, "code": 401, "parameters": ["I'm \\n[1] by the way."]}, {"indent": 0, "code": 101, "parameters": ["Kim Face Set 5", 5, 0, 2]}, {"indent": 0, "code": 401, "parameters": ["I said it before, don't mention it."]}, {"indent": 0, "code": 401, "parameters": ["Good luck \\n[1]."]}, {"indent": 0, "code": 121, "parameters": [724, 724, 0]}, {"indent": 0, "code": 355, "parameters": ["global_save"]}, {"indent": 0, "code": 123, "parameters": ["B", 0]}, {"indent": 0, "code": 313, "parameters": [0, 1, 0, 53]}, {"indent": 0, "code": 0, "parameters": []}], "moveFrequency": 3, "moveRoute": {"repeat": true, "skippable": false, "wait": false, "list": [{"code": 0, "parameters": []}]}, "moveSpeed": 3, "moveType": 0, "priorityType": 0, "stepAnime": false, "through": false, "trigger": 0, "walkAnime": true, "image": {"tileId": 0, "characterName": "", "characterIndex": 0, "direction": 2, "pattern": 0}}, {"conditions": {"switch1Valid": false, "switch2Valid": false, "variableValid": false, "selfSwitchValid": true, "itemValid": false, "actorValid": false, "switch1Id": 1, "switch2Id": 1, "variableId": 1, "variableValue": 0, "selfSwitchCh": "B", "itemId": 1, "a